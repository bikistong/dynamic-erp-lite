// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH MODELS
// ============================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("staff") // admin, staff
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================
// MASTER DATA MODELS
// ============================================

// Chart of Accounts (COA)
model ChartOfAccounts {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   // Asset, Liability, Equity, Revenue, Expense
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalLines JournalLine[]
  generalLedger GeneralLedger[]

  @@map("chart_of_accounts")
}

// Item Master
model Item {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  description     String?
  stock           Int      @default(0)
  uom             String   // Unit of Measure: pcs, kg, liter, etc
  purchasePrice   Float    @default(0)
  sellingPrice    Float    @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  stockMovements   StockMovement[]
  purchaseLines    PurchaseOrderLine[]
  salesLines       SalesInvoiceLine[]

  @@map("items")
}

// Customer Master
model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  phone       String?
  address     String?
  city        String?
  province    String?
  postalCode  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  salesInvoices SalesInvoice[]

  @@map("customers")
}

// Supplier Master
model Supplier {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  phone       String?
  address     String?
  city        String?
  province    String?
  postalCode  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  purchaseOrders PurchaseOrder[]
  apPayments     APPayment[]

  @@map("suppliers")
}

// ============================================
// TRANSACTION MODELS
// ============================================

// Purchase Order
model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  supplierId  String
  date        DateTime
  dueDate     DateTime?
  status      String   @default("draft") // draft, submitted, received, cancelled
  totalAmount Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lines       PurchaseOrderLine[]
  journal     Journal?  @relation("purchase_order_journal")

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id             String   @id @default(cuid())
  purchaseOrder  PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId           String
  item           Item     @relation(fields: [itemId], references: [id])
  itemId         String
  quantity       Int
  unitPrice      Float
  totalAmount    Float    @default(0)
  receivedQty    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("purchase_order_lines")
}

// AP Payment (Bayar hutang ke supplier)
model APPayment {
  id            String    @id @default(cuid())
  paymentNo     String    @unique
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  supplierId    String
  receipt       PurchaseReceipt? @relation(fields: [receiptId], references: [id])
  receiptId     String?
  date          DateTime
  amount        Float
  method        String    @default("cash") // cash, transfer, check
  reference     String?   // bukti transfer / nomor cek
  notes         String?
  journal       Journal?  @relation("ap_payment_journal")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("ap_payments")
  @@index([supplierId])
}

// Purchase Receipt (Goods Received Note)
model PurchaseReceipt {
  id             String   @id @default(cuid())
  receiptNumber  String   @unique
  poNumber       String
  date           DateTime
  status         String   @default("posted") // draft, posted
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  stockMovements StockMovement[]
  journal        Journal?  @relation("purchase_receipt_journal")
  apPayments     APPayment[]

  @@map("purchase_receipts")
}

// Sales Invoice
model SalesInvoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  String
  date        DateTime
  dueDate     DateTime?
  status      String   @default("draft") // draft, posted, paid, cancelled
  subtotal    Float    @default(0)        // before tax
  taxRate     Float    @default(11)       // PPN percentage, e.g. 11
  taxAmount   Float    @default(0)        // subtotal * taxRate / 100
  totalAmount Float    @default(0)        // subtotal + taxAmount
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lines       SalesInvoiceLine[]
  journal     Journal?  @relation("sales_invoice_journal")

  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id          String   @id @default(cuid())
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  item        Item     @relation(fields: [itemId], references: [id])
  itemId      String
  quantity    Int
  unitPrice   Float
  totalAmount Float    @default(0)  // quantity * unitPrice (before tax)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sales_invoice_lines")
}

// ============================================
// INVENTORY MODELS
// ============================================

// Stock Movement (Tracking stock in/out)
model StockMovement {
  id             String   @id @default(cuid())
  item           Item     @relation(fields: [itemId], references: [id])
  itemId         String
  type           String   // in, out, adjustment
  quantity       Int
  reference      String?  // PO number, Invoice number, etc
  referenceType  String?  // po, sales, adjustment
  notes          String?
  createdAt      DateTime @default(now())

  // Relations
  purchaseReceipt PurchaseReceipt? @relation(fields: [receiptId], references: [id])
  receiptId       String?

  @@map("stock_movements")
  @@index([itemId])
  @@index([createdAt])
}

// ============================================
// ACCOUNTING MODELS
// ============================================

// Journal (General Journal)
model Journal {
  id            String   @id @default(cuid())
  journalNo     String   @unique
  date          DateTime
  description   String
  type          String   // manual, auto
  reference     String?  // PO, Invoice, Receipt number
  referenceType String?  // po, sales, receipt
  status        String   @default("draft") // draft, posted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  lines         JournalLine[]
  generalLedger GeneralLedger[]
  purchaseOrder PurchaseOrder? @relation("purchase_order_journal", fields: [poId], references: [id])
  poId          String?  @unique
  salesInvoice  SalesInvoice? @relation("sales_invoice_journal", fields: [invoiceId], references: [id])
  invoiceId     String?  @unique
  purchaseReceipt PurchaseReceipt? @relation("purchase_receipt_journal", fields: [receiptId], references: [id])
  receiptId     String?  @unique
  apPayment     APPayment? @relation("ap_payment_journal", fields: [apPaymentId], references: [id])
  apPaymentId   String?  @unique

  @@map("journals")
  @@index([date])
  @@index([status])
}

// Journal Line (Debit/Credit entries)
model JournalLine {
  id             String   @id @default(cuid())
  journal        Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  journalId      String
  account        ChartOfAccounts @relation(fields: [accountId], references: [id])
  accountId      String
  description    String?
  debit          Float    @default(0)
  credit         Float    @default(0)
  createdAt      DateTime @default(now())

  @@map("journal_lines")
  @@index([journalId])
}

// General Ledger (Posting results)
model GeneralLedger {
  id             String   @id @default(cuid())
  accountId      String
  account        ChartOfAccounts @relation(fields: [accountId], references: [id])
  journalId      String
  journal        Journal  @relation(fields: [journalId], references: [id])
  date           DateTime
  description    String?
  debit          Float    @default(0)
  credit         Float    @default(0)
  balance        Float    @default(0)
  createdAt      DateTime @default(now())

  @@map("general_ledger")
  @@index([accountId])
  @@index([date])
}
